<UserControl x:Class="UsbDlpAgent.UI.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UsbDlpAgent.UI"
             xmlns:models="clr-namespace:UsbDlpAgent.SharedModels;assembly=UsbDlpAgent.SharedModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <DatePicker x:Name="StartDatePicker"
                        materialDesign:HintAssist.Hint="Từ ngày"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        Margin="0,0,10,0"
                        Width="150"/>
            <DatePicker x:Name="EndDatePicker"
                        materialDesign:HintAssist.Hint="Đến ngày"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        Margin="0,0,20,0"
                        Width="150"/>
            <TextBox x:Name="KeywordTextBox"
                     materialDesign:HintAssist.Hint="Từ khóa (tệp, người dùng...)"
                     Width="250"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,10,0"
                     VerticalAlignment="Bottom"/>
            <Button Content="Tải Lịch sử"
                    Click="LoadHistoryButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    VerticalAlignment="Bottom"/>
        </StackPanel>

        <ListView Grid.Row="1"
                  Name="HistoryListView"
                  SelectionChanged="HistoryListView_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Thời gian"
                                    Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss.fff'}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Loại Sự kiện"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Đường dẫn Tệp"
                                    Width="350"
                                    DisplayMemberBinding="{Binding FilePath}"/>
                    <GridViewColumn Header="Đường dẫn Cũ"
                                    Width="200"
                                    DisplayMemberBinding="{Binding OldFilePath}"/>
                    <GridViewColumn Header="Ổ đĩa"
                                    Width="70"
                                    DisplayMemberBinding="{Binding Drive}"/>
                    <GridViewColumn Header="Người dùng"
                                    Width="100"
                                    DisplayMemberBinding="{Binding UserName}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <materialDesign:Card Grid.Row="2"
                             Margin="0,10,0,0"
                             Padding="15"
                             Visibility="{Binding ElementName=HistoryListView, Path=SelectedItem, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel DataContext="{Binding ElementName=HistoryListView, Path=SelectedItem}">
                <TextBlock Text="Chi tiết Sự kiện Lịch sử"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"
                                          MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="ID Sự kiện:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Id}"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Thời gian:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss.fff'}"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Loại:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding Type}"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Đường dẫn:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding FilePath}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Đường dẫn cũ:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"
                               Visibility="{Binding OldFilePath, Converter={StaticResource NullOrEmptyToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding OldFilePath}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"
                               Visibility="{Binding OldFilePath, Converter={StaticResource NullOrEmptyToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Ổ đĩa:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="{Binding Drive}"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Người dùng:"
                               FontWeight="SemiBold"
                               Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="{Binding UserName}"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>