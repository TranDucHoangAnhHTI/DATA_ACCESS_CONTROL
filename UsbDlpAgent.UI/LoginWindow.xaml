<Window x:Class="UsbDlpAgent.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsbDlpAgent.UI"
        mc:Ignorable="d"
        Title="Đăng nhập - USB DLP Agent"
        Height="400"
        Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ĐĂNG NHẬP"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            <TextBox x:Name="UsernameTextBox"
                     Margin="0,10"
                     Padding="5">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <TextBlock Text="Tên đăng nhập" 
                                                     Foreground="Gray"
                                                     Margin="5,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <PasswordBox x:Name="PasswordBox"
                         Margin="0,10"
                         Padding="5">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="PasswordBox">
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <TextBlock Text="Mật khẩu" 
                                                     Foreground="Gray"
                                                     Margin="5,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Password.Length, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
            <Button Content="Đăng nhập"
                    x:Name="LoginButton"
                    Click="LoginButton_Click"
                    IsDefault="True"
                    Margin="0,20,0,0"
                    Width="150"
                    Height="35"
                    Background="#673AB7"
                    Foreground="White"
                    BorderThickness="0"
                    HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5E35B1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock x:Name="ErrorMessageTextBlock"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>