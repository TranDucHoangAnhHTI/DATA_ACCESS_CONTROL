<Window x:Class="UsbDlpAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsbDlpAgent.UI"
        xmlns:models="clr-namespace:UsbDlpAgent.SharedModels;assembly=UsbDlpAgent.SharedModels"
        mc:Ignorable="d"
        Title="USB DLP Agent Monitor"
        Height="600"
        Width="1000"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,10">
            <TextBlock Text="Event Log"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="Request History"
                    Margin="20,0,0,0"
                    Padding="5"
                    Click="RequestHistoryButton_Click"/>
        </StackPanel>


        <ListView Grid.Row="1"
                  Name="EventListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Timestamp"
                                    Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="File Path"
                                    Width="350"
                                    DisplayMemberBinding="{Binding FilePath}"/>
                    <GridViewColumn Header="Old File Path"
                                    Width="250"
                                    DisplayMemberBinding="{Binding OldFilePath}"/>
                    <GridViewColumn Header="Drive"
                                    Width="70"
                                    DisplayMemberBinding="{Binding Drive}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="ConnectionStatusText"
                           Text="Status: Initializing..."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>