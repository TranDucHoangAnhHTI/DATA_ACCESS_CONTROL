<Window x:Class="UsbDlpAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsbDlpAgent.UI"
        xmlns:models="clr-namespace:UsbDlpAgent.SharedModels;assembly=UsbDlpAgent.SharedModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="USB DLP Agent Monitor - Giám sát tác nhân"
        Height="700"
        Width="1200"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Mode="PrimaryMid"
                                  Grid.Row="0"
                                  Padding="16">
            <DockPanel>
                <TextBlock Text="GIÁM SÁT TÁC NHÂN USB DLP"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                <Button x:Name="LogoutButton"
                        Content="Đăng xuất"
                        DockPanel.Dock="Right"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Click="LogoutButton_Click"/>
                <TextBlock Text="Người dùng: admin"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,20,0"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <TabControl Grid.Row="1"
                    Margin="5"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Style="{StaticResource MaterialDesignTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="EyeCheckOutline"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Theo dõi Thời gian thực"/>
                    </StackPanel>
                </TabItem.Header>
                <local:RealtimeEventsView x:Name="RealtimeViewInstance"/>
            </TabItem>

            <TabItem Style="{StaticResource MaterialDesignTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Xem lại Lịch sử"/>
                    </StackPanel>
                </TabItem.Header>
                <local:HistoryView x:Name="HistoryViewInstance"/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="ConnectionStatusText"
                           Text="Trạng thái: Đang khởi tạo..."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>