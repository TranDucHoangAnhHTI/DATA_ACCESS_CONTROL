<Window x:Class="UsbDlpAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsbDlpAgent.UI"
        xmlns:models="clr-namespace:UsbDlpAgent.SharedModels;assembly=UsbDlpAgent.SharedModels"
        mc:Ignorable="d"
        Title="Ứng dụng giám sát truy cập dữ liệu"
        Height="600"
        Width="1000"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#F5F5F5">
    <Window.Resources>
        <local:DateTimeConverter x:Key="DateTimeConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                Margin="0,0,0,10">
            <TextBlock Text="USB DLP Agent Monitor"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Monitor and manage USB device activities in real-time"
                       Foreground="#666666"/>
        </StackPanel>

        <!-- Status Bar -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10"
                        Height="10"
                        Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill"
                                    Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}"
                                        Value="True">
                                    <Setter Property="Fill"
                                            Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReconnecting}"
                                        Value="True">
                                    <Setter Property="Fill"
                                            Value="#FFC107"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="ConnectionStatusText"
                           Text="Trạng thái: Ngắt kết nối"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
                <TextBlock x:Name="EventCountText"
                           Text="0 sự kiện"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           Margin="0,0,20,0"/>

                <!-- Toggle Buttons -->
                <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,0">
                    <ToggleButton x:Name="NotificationToggle"
                                  IsChecked="{Binding ShowNotifications, Mode=TwoWay}"
                                  ToolTip="Bật/tắt thông báo sự kiện mới"
                                  Width="30"
                            Height="30"
                                  Margin="0,0,5,0">
                        <Path Data="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.9,2 2,2zM18,16v-5c0,-3.07 -1.63,-5.64 -4.5,-6.32L13.5,4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.64,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2zM16,17L8,17v-6c0,-2.48 1.51,-4.5 4,-4.5s4,2.02 4,4.5v6z"
                              Fill="#666666"
                              Stretch="Uniform"
                              Margin="5"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AutoScrollToggle"
                                  IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                  ToolTip="Bật/tắt tự động cuộn khi có sự kiện mới"
                                  Width="30"
                            Height="30">
                        <Path Data="M16,13h-3v3h-2v-3H8v-2h3V8h2v3h3V13zM17,3H7C5.9,3 5,3.9 5,5v14c0,1.1 0.9,2 2,2h10c1.1,0 2,-0.9 2,-2V5C19,3.9 18.1,3 17,3zM17,19H7V5h10V19z"
                              Fill="#666666"
                              Stretch="Uniform"
                              Margin="5"/>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filter Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tìm kiếm theo từ khóa -->
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Nhập từ khóa để tìm kiếm (tên file, đường dẫn, ổ đĩa)">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <TextBlock Text="Tìm kiếm..."
                                                       Foreground="Gray"
                                                       Margin="5,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Value="0">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                    Margin="5,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Lọc theo loại sự kiện -->
            <ComboBox x:Name="TypeFilterCombo"
                      Grid.Column="1"
                      Margin="0,0,10,0"
                      Width="150"
                      ToolTip="Lọc theo loại hoạt động"
                      SelectionChanged="TypeFilterCombo_SelectionChanged">
            </ComboBox>

            <!-- Lọc theo ổ đĩa -->
            <ComboBox x:Name="DriveFilterCombo"
                      Grid.Column="2"
                      Margin="0,0,10,0"
                      Width="100"
                      ToolTip="Lọc theo ổ đĩa"
                      SelectionChanged="DriveFilterCombo_SelectionChanged">
            </ComboBox>

            <!-- Lọc theo thời gian -->
            <Grid Grid.Column="3" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="StartDatePicker"
                          Width="120"
                          ToolTip="Chọn ngày bắt đầu"
                          SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                <TextBlock Grid.Column="1" 
                         Text="đến" 
                         Margin="5,0"
                         VerticalAlignment="Center"/>
                <DatePicker x:Name="EndDatePicker"
                          Grid.Column="2"
                          Width="120"
                          ToolTip="Chọn ngày kết thúc"
                          SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            </Grid>

            <!-- Các nút chức năng -->
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="RefreshButton" 
                        Click="RefreshButton_Click" 
                        ToolTip="Làm mới danh sách" 
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,5,0">
                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z" 
                          Fill="#2196F3" Width="20" Height="20"/>
                </Button>
                <Button x:Name="ExportPdfButton" 
                        Click="ExportPdfButton_Click" 
                        ToolTip="Xuất báo cáo PDF" 
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,5,0">
                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M16,11V18.1L13.9,16L11.1,18.8L8.3,16L11.1,13.2L8.9,11H16M12.9,14.9L14.3,16.3L11.5,19.1L10.1,17.7L12.9,14.9Z" 
                          Fill="#4CAF50" Width="20" Height="20"/>
                </Button>
                <Button x:Name="ClearFiltersButton" 
                        Click="ClearFilters_Click" 
                        ToolTip="Xóa tất cả bộ lọc"
                        Background="Transparent"
                        BorderThickness="0">
                    <Path Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z" 
                          Fill="#FF9800" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Event List -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="EventListView"
                      MouseDoubleClick="EventListView_MouseDoubleClick"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Thời gian" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="Timestamp"
                                                        Converter="{StaticResource DateTimeConverter}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Loại" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}"
                                                            Value="Created">
                                                        <Setter Property="Foreground"
                                                                Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}"
                                                            Value="Modified">
                                                        <Setter Property="Foreground"
                                                                Value="#2196F3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}"
                                                            Value="Deleted">
                                                        <Setter Property="Foreground"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}"
                                                            Value="Renamed">
                                                        <Setter Property="Foreground"
                                                                Value="#9C27B0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Đường dẫn" Width="400">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilePath}"
                                             TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Đường dẫn cũ" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OldFilePath}"
                                             TextTrimming="CharacterEllipsis"
                                             Foreground="#666666">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OldFilePath}"
                                                            Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Ổ đĩa" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Drive}"
                                             HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>