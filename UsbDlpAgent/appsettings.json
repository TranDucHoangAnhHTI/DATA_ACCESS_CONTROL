{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UsbDlpAgent": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "UsbDlpAgent.Services.AlertService": "Warning"
      }
    }
  },
  "DlpSettings": {
    "LocalPathsToMonitor": [
      "C:\\USB"
    ],
    "MoveDetectionWindowSeconds": 10,
    "MaxDeletedFilesCache": 200,
    "EventHistoryFilePath": "D:\\ProgramData\\UsbDlpAgent\\event_history.ndjson",
    "MaxHistoryFileItems": 10000
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5121"
      }
    }
  },
  "AllowedHosts": "*"
}